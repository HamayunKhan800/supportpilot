{
  "name": "supportpilot",
  "version": "0.1.0",
  "description": "AI-assisted customer support with grounded, cited answers and a human in the loop.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:scripts": "tsx scripts/bundle.ts",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:smoke": "vitest run --project smoke",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "auth:generate": "auth generate --config scripts/auth-cli.config.ts --output src/server/platform/db/auth-schema.ts",
    "test:e2e": "playwright test",
    "test:e2e:accounts": "playwright test -c playwright.accounts.config.ts",
    "test:visual:update": "playwright test visual --update-snapshots",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "eval:fusion": "tsx scripts/eval-fusion.ts",
    "eval:threshold": "tsx scripts/eval-threshold.ts",
    "eval:ai": "tsx scripts/eval-ai-smoke.ts",
    "eval:review": "tsx scripts/eval-review.ts",
    "eval:state": "tsx scripts/eval-state.ts",
    "eval:compare": "tsx scripts/eval-compare.ts",
    "design:tokens": "tsx scripts/design-tokens.ts",
    "kb:reembed": "tsx scripts/kb-reembed.ts",
    "otel:capture": "tsx scripts/otel-capture.ts",
    "sentry:check": "tsx scripts/sentry-check.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.114",
    "@aws-sdk/client-lambda": "3.1164.0",
    "@aws-sdk/client-ssm": "3.1164.0",
    "@base-ui/react": "^1.9.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.0",
    "@opentelemetry/core": "3.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@sentry/nextjs": "11.11.0",
    "@sentry/node": "11.11.0",
    "ai": "7.0.165",
    "better-auth": "1.7.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "geist": "1.9.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "pg-boss": "12.38.1",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "auth": "1.7.18",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^5.1.0"
  }
}
