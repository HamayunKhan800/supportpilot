{
  "name": "supportpilot",
  "version": "0.1.0",
  "description": "AI-assisted customer support with grounded, cited answers and a human in the loop.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:scripts": "tsx scripts/bundle.ts",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:smoke": "vitest run --project smoke",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "auth:generate": "auth generate --config scripts/auth-cli.config.ts --output src/server/platform/db/auth-schema.ts",
    "test:e2e": "playwright test",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "eval:fusion": "tsx scripts/eval-fusion.ts",
    "eval:ai": "tsx scripts/eval-ai-smoke.ts",
    "eval:review": "tsx scripts/eval-review.ts",
    "kb:reembed": "tsx scripts/kb-reembed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.97",
    "@base-ui/react": "^1.9.0",
    "ai": "7.0.142",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "pg-boss": "12.38.0",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "auth": "1.7.12",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^5.0.5"
  }
}
