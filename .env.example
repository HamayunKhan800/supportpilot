# Copy to .env.local for local development. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

# Local Postgres from docker-compose.yml (dev-only credentials)
DATABASE_URL=postgres://supportpilot:supportpilot@localhost:5432/supportpilot
TEST_DATABASE_URL=postgres://supportpilot:supportpilot@localhost:5432/supportpilot_test
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
# AUTH_TRUSTED_ORIGINS=https://preview.example.com
# AUTH_RATE_LIMIT_ENABLED=true
# PORTAL_RATE_LIMIT_ENABLED=true
# Only behind a proxy that overwrites X-Forwarded-For (see docs, M8). Used by the portal and
# sign-in limits; when off, every client shares one limit bucket.
# TRUST_PROXY_HEADERS=false
# Optional Google and GitHub sign-in: buttons appear only when both values are set.
# Callbacks: <BETTER_AUTH_URL>/api/auth/callback/google and .../callback/github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email (ADR-0020). Unset = no password reset and no email verification (the default).
# outbox = kept in memory, read at /api/dev/email-outbox with the header x-outbox-token.
#          For local development and tests only, never on a public server.
# resend = real email; sending to anyone but yourself needs a domain verified in Resend.
# EMAIL_PROVIDER=outbox
# EMAIL_FROM="SupportPilot <no-reply@example.com>"
# EMAIL_OUTBOX_TOKEN=   # 32+ characters: openssl rand -base64 32
# RESEND_API_KEY=       # from https://resend.com/api-keys, when EMAIL_PROVIDER=resend

# AI provider: mock (offline, deterministic, default outside production) or gemini.
# Production must set it explicitly. Demo data only: the Gemini free tier may use inputs
# to improve Google's products.
AI_PROVIDER=mock
# GEMINI_API_KEY=   # from https://aistudio.google.com/apikey, required when AI_PROVIDER=gemini
# AI_DAILY_CALL_LIMIT=200   # triage + draft calls per day for the whole deployment (Pacific-time day); 0 = AI generation off
# AI_DAILY_EMBEDDING_LIMIT=800   # texts sent to Gemini for embedding per Pacific-time day (uploads: one per chunk; each search or draft: one)

# Evaluation Review page (M6): sign-in emails, comma-separated, that may open /app/review to
# check the test data by hand. Unset = off: no link, and the page and its API answer 404
# (signed-out visitors are sent to sign-in first, as on every /app page).
# EVAL_REVIEWER_EMAILS=owner@demo.supportpilot.dev

# Observability (M6, docs/observability.md). Both optional; unset = off.
# Traces (OpenTelemetry, OTLP/HTTP): e.g. `pnpm otel:capture` or Jaeger on port 4318.
# Only allowlisted metadata leaves the app: never ticket text, prompts or tokens.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=   # for a hosted backend that needs a key: name=value
# Errors (Sentry): the DSN from Project Settings > Client Keys. It can only send events, not
# read them, but keep it in the environment rather than in code. Check it with `pnpm sentry:check`.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Optional: allow framing by specific https origins (default 'none').
# CSP_FRAME_ANCESTORS='self' https://*.example.com

# Shared demo accounts (scripts/seed-demo.ts). Accounts on this domain can't change their
# password, sessions, linked sign-ins or members, and are never emailed. Use a subdomain of
# a domain you own on public deployments.
# DEMO_EMAIL_DOMAIN=demo.supportpilot.dev

# Single-container hosting (node .build/start.mjs runs web + worker; plan M8 D2). Keep both
# below the host's shutdown deadline (Cloud Run: 10 s).
# LAUNCHER_GRACE_MS=9000
# WORKER_SHUTDOWN_TIMEOUT_MS=8000
