# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bundled CLI scripts (migrate, worker)
/.build/

# allow committing the env template
!.env.example

# Playwright
/playwright-report/
/test-results/
/blob-report/

# Embedding cache of pnpm eval:retrieval (vectors keyed by hash; regenerated on demand)
eval/cache/

# Mock evaluation results (pnpm eval): rewritten every run, kept as a CI artifact instead
eval/results/eval-mock.json
eval/results/eval-mock.md
